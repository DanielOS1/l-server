# Base de datos — usar DATABASE_URL (recomendado en producción) o las variables
# individuales de abajo (coinciden con docker-compose.yml para desarrollo local).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=gestion_actividades_db

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=7d

# App
PORT=3000
FRONTEND_URL=http://localhost:5173
